{
  "name": "la-carte-des-savoirs-backend",
  "scripts": {
    "dev": "tsx node_modules/moleculer/bin/moleculer-runner.js --hot --repl services/*.service.js services/**/*.service.js",
    "start": "tsx node_modules/moleculer/bin/moleculer-runner.js services/*.service.js services/**/*.service.js",
    "link-packages": "yarn link @activitypods/app",
    "unlink-packages": "yarn unlink @activitypods/app && yarn install --force"
  },
  "dependencies": {
    "@activitypods/app": "2.3.2",
    "@semapps/auth": "1.2.4",
    "@semapps/core": "1.2.4",
    "@semapps/crypto": "1.2.4",
    "@semapps/importer": "1.2.4",
    "@semapps/ldp": "1.2.4",
    "@semapps/solid": "1.2.4",
    "@rdfjs/data-model": "^2.1.1",
    "dotenv-flow": "^3.2.0",
    "ioredis": "^4.17.3",
    "url-join": "^4.0.1",
    "moleculer-repl": "^0.6.6",
    "moleculer": "^0.14.35"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
