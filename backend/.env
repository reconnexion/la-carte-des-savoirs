SEMAPPS_APP_NAME="La Carte des Savoirs"
SEMAPPS_APP_DESCRIPTION="Partagez vos savoirs et compétences avec votre réseau"
SEMAPPS_APP_LANG="fr"

SEMAPPS_HOME_URL=http://localhost:3001/
SEMAPPS_FRONT_URL=http://localhost:4001/
SEMAPPS_PORT=3001

SEMAPPS_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/
# Our pair:ExperienceAssociation shape tree, until it is merged into activitypods/shapes and
# deployed on https://shapes.activitypods.org (see README). Run `yarn start` from a local
# checkout of https://github.com/activitypods/shapes (or the `shapes` docker-compose-dev service)
# to serve it on this port.
SEMAPPS_CUSTOM_SHAPE_REPOSITORY_URL=http://localhost:30916/

# Triple store
SEMAPPS_SPARQL_ENDPOINT=http://localhost:3030/
SEMAPPS_JENA_USER=admin
SEMAPPS_JENA_PASSWORD=admin
SEMAPPS_MAIN_DATASET=activitypods-app
SEMAPPS_AUTH_ACCOUNTS_DATASET_NAME=settings-app

# Redis (format: redis://localhost:6379/0)
SEMAPPS_REDIS_CACHE_URL=
SEMAPPS_QUEUE_SERVICE_URL=redis://localhost:6379/11
