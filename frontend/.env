VITE_APP_NAME="La Carte des Savoirs"
VITE_APP_DESCRIPTION="Partagez vos savoirs et compétences avec votre réseau"
VITE_APP_LANG="fr"

VITE_PORT=4001

VITE_BACKEND_URL=http://localhost:3001/
VITE_BACKEND_CLIENT_ID=${VITE_BACKEND_URL}app

VITE_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/

# If this is defined, the user will not be able to choose a pod provider
# This is useful to test a pod provider in a local dev environment
VITE_POD_PROVIDER_BASE_URL=http://localhost:3000

# Required to display the map and geocode addresses.
# See https://docs.mapbox.com/help/getting-started/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=
